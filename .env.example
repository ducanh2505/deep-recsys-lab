# Explicit schema-v3 ONNX model tag. The backend intentionally rejects "latest".
MODEL_TAG=deep_recsys:multvae-onnx-v1

# Host BentoML home containing the models/ directory mounted read-only by Compose.
BENTOML_HOST_HOME=${HOME}/bentoml

# Host exposure. Change HOST_BIND to 0.0.0.0 only when LAN access is intended.
HOST_BIND=127.0.0.1
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Leave empty to disable authentication. Enter the same value in the UI when enabled.
DEEP_RECSYS_API_KEY=
